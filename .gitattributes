* text=auto

.gitattributes text eol=lf
.gitignore text eol=lf

# Generatorausgaben und Quellcode werden bytegenau mit LF geprueft.
*.c text eol=lf
*.h text eol=lf
*.md text eol=lf
*.zig text eol=lf
*.zon text eol=lf

# Der uebernommene Contract bleibt bytegenau; Diffs bleiben textuell.
*.txt -text diff
*.json -text diff
